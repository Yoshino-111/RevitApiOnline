<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2020' Or '$(RevitVersion)' == '2021' Or '$(RevitVersion)' == '2022' Or '$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FamilyMEP.Plugin</AssemblyName>
    <RootNamespace>FamilyMEP.Plugin</RootNamespace>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <RevitApiPath Condition="'$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'">C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</RevitApiPath>
    <RevitApiUiPath Condition="'$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'">C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</RevitApiUiPath>
    <RevitApiPath Condition="'$(RevitVersion)' == '2026'">C:\RevitReferencePacks\2026\RevitAPI.dll</RevitApiPath>
    <RevitApiUiPath Condition="'$(RevitVersion)' == '2026'">C:\RevitReferencePacks\2026\RevitAPIUI.dll</RevitApiUiPath>
    <RevitApiPath Condition="'$(RevitVersion)' == '2027'">C:\RevitReferencePacks\2027\RevitAPI.dll</RevitApiPath>
    <RevitApiUiPath Condition="'$(RevitVersion)' == '2027'">C:\RevitReferencePacks\2027\RevitAPIUI.dll</RevitApiUiPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiUiPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\RevitHotReload.Abstractions\RevitHotReload.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Ui\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Ui\DrainConnectionWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Ui\SprinklerModelerWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Ui\ExteriorWallMapperWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Ui\SmartTagWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Ui\SmartTagQuickAlignWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Backgrounds\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\DrainConnection\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\DrainConnection\case01-thumb.png" />
    <EmbeddedResource Include="Assets\DrainConnection\case02-thumb.png" />
    <EmbeddedResource Include="Assets\DrainConnection\case03-thumb.png" />
    <EmbeddedResource Include="Assets\DrainConnection\case04-thumb.png" />
    <EmbeddedResource Include="Assets\DrainConnection\case05-thumb.png" />
    <EmbeddedResource Include="Assets\DrainConnection\case06-thumb.png" />
  </ItemGroup>
</Project>
