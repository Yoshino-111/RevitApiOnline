<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Tag Setup" Width="1500" Height="900"
        MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" Background="#151A20" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#20262D"/>
        <SolidColorBrush x:Key="Panel2" Color="#282F37"/>
        <SolidColorBrush x:Key="Border" Color="#3A434D"/>
        <SolidColorBrush x:Key="Ink" Color="#F3F6F8"/>
        <SolidColorBrush x:Key="Muted" Color="#A8B2BC"/>
        <SolidColorBrush x:Key="Blue" Color="#1686F5"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#303842"/>
            <Setter Property="BorderBrush" Value="#4A5561"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="#1686F5"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#171C22"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#161A1F"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,7,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B2128" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SMART TAG SETUP" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="view_name_text" Text="Capturing Active View..." FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="live_preview_cb" IsChecked="False" Visibility="Collapsed"/>
                    <TextBlock Text="SELECT CATEGORIES → APPLY SELECTION"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="smart_dim_btn" Content="SMART DIM" MinWidth="120" Margin="0,0,8,0"
                            ToolTip="Pick one sample cluster rectangle, then apply that width and height to all checked model elements across the Active View."/>
                    <Button x:Name="pick_elements_btn" Content="SCAN ELEMENTS" MinWidth="155" Margin="0,0,8,0"
                            ToolTip="Hide this window, then drag a Revit selection rectangle around only the MEP elements to tag."/>
                    <Button x:Name="refresh_btn" Content="REFRESH ACTIVE VIEW" MinWidth="170"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F1318" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                <Grid x:Name="preview_surface" Background="#E8EAED">
                    <Grid x:Name="preview_content" RenderTransformOrigin="0,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="preview_scale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="preview_translate" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image x:Name="preview_image" Stretch="Uniform" Opacity="0.72"/>
                        <Canvas x:Name="overlay_canvas" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Grid>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,6"
                            Background="#E8171C22" CornerRadius="4">
                        <TextBlock x:Name="preview_mode_text"
                                   Text="ACTIVE VIEW — select categories to render project tags"
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="9,6"
                            Background="#E8171C22" CornerRadius="4">
                        <TextBlock x:Name="zoom_text" Text="100%" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,7"
                            Background="#E8171C22" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="#159447" Margin="0,0,5,0"/>
                            <TextBlock Text="Single line" Margin="0,0,18,0"/>
                            <TextBlock Text="●" Foreground="#F2A11B" Margin="0,0,5,0"/>
                            <TextBlock Text="Free End on host + orthogonal elbow" Margin="0,0,18,0"/>
                            <TextBlock Text="Mouse wheel: Zoom" Foreground="#7FC5FF"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="9">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="1  CATEGORIES TO TAG" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose category + project Tag Family : Type"
                                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/>
                                <StackPanel x:Name="category_list"/>
                                <TextBlock Text="Selection only. Categories are solved together after Apply Selection + Analyze."
                                           Foreground="#7FC5FF" FontSize="11" Margin="0,7,0,0"/>
                                <Border Margin="0,8,0,0" Padding="9,7" CornerRadius="6"
                                        Background="#172B35" BorderBrush="#2F6C80" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="DUCT CHANGE FILTER" Foreground="#68D7F3"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Tag size/elevation changes only  •  size-change segment ≥ 500 mm  •  same-size elbows skipped"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="#C4D7E0" FontSize="10"/>
                                        <Button x:Name="pick_duct_density_zone_btn"
                                                Content="PICK SAMPLE AREA  •  MAX 10 DUCT TAGS"
                                                Height="28" Margin="0,7,0,0" Padding="8,2"
                                                FontSize="10" HorizontalAlignment="Stretch"
                                                ToolTip="Pick one sample area. Its width and height repeat across the Active View; each repeated area receives at most 10 eligible Duct tags."/>
                                        <TextBlock x:Name="duct_density_zone_text"
                                                   Text="No sample yet: maximum 10 Duct tags in the current view."
                                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Foreground="#7FC5FF" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="SMART DIM SETTINGS" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Maximum gap between consecutive elements (model mm)"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="dim_cluster_gap_tb" Text="2500"
                                         ToolTip="Elements farther apart than this actual model distance start a new local dimension cluster."/>
                                <TextBlock Text="Elements at or below this distance form one continuous chain. Each chain starts and ends at Wall references when available; otherwise at the nearest Grids."
                                           TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                           FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock Text="After clicking SMART DIM, drag one sample cluster zone in Revit. The zone sets the maximum width and height of every local cluster across the Active View; it does not filter elements to that picked location."
                                           TextWrapping="Wrap" Foreground="#7FC5FF"
                                           FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="2  TAG COLUMN" FontWeight="Bold" FontSize="14"/>
                                 <TextBlock Text="Layout Style" Style="{StaticResource FieldLabel}"/>
                                 <ComboBox x:Name="layout_style_combo" SelectedIndex="1">
                                     <ComboBoxItem Content="Standard" Tag="Standard"/>
                                     <ComboBoxItem Content="Standard V2 (recommended for Duct + DA/AT)" Tag="StandardNearHost"/>
                                     <ComboBoxItem Content="Guided Zones (force tags inside picked area)" Tag="GuidedZones"/>
                                 </ComboBox>
                                 <Border x:Name="guided_zone_panel" Visibility="Collapsed"
                                         Margin="0,10,0,2" Padding="10"
                                         BorderBrush="#526170" BorderThickness="1" CornerRadius="4"
                                         Background="#17212A">
                                     <StackPanel>
                                         <TextBlock Text="GUIDED TAG ZONE" FontWeight="Bold" Foreground="#7FC5FF"/>
                                         <TextBlock Text="1. SCAN ELEMENTS  2. Pick any tag area  3. Apply + Analyze"
                                                    Margin="0,3,0,8" TextWrapping="Wrap" Foreground="#B8C4CE"/>
                                         <TextBlock Text="Side: Left/Right uses one column. Auto creates Left + Right when two real tag widths fit; a narrower picked zone falls back to one compressed column."
                                                    Margin="0,0,0,8" TextWrapping="Wrap" FontSize="10" Foreground="#8FA2B2"/>
                                         <TextBlock Text="The picked zone is authoritative: tight rows are compressed and blocked rows are kept with clash warnings; Analyze never asks you to scan again."
                                                    Margin="0,0,0,8" TextWrapping="Wrap" FontSize="10" Foreground="#FFCC80"/>
                                         <Button x:Name="suggest_tag_zone_btn" Content="AUTO FIND CLEAR TAG ZONE"
                                                 Height="32" Margin="0,0,0,6"/>
                                         <Button x:Name="pick_tag_zone_btn" Content="PICK ANOTHER ZONE IN REVIT"
                                                 Height="32"/>
                                         <TextBlock x:Name="guided_zone_text" Text="No tag zone selected."
                                                    Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#FFCC80"/>
                                     </StackPanel>
                                 </Border>
                                 <TextBlock Text="Standard remains unchanged. Standard V2 arranges and validates Duct + DA/AT."
                                            TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                                 <TextBlock Text="Side" Style="{StaticResource FieldLabel}"/>
                                 <ComboBox x:Name="side_combo" SelectedIndex="0">
                                     <ComboBoxItem Content="Auto - split Left + Right" Tag="Auto"/>
                                     <ComboBoxItem Content="Left only" Tag="Left"/>
                                     <ComboBoxItem Content="Right only" Tag="Right"/>
                                 </ComboBox>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                         <TextBlock Text="Group Search Width (paper mm)" Style="{StaticResource FieldLabel}"/>
                                         <TextBox x:Name="column_width_tb" Text="60"/>
                                     </StackPanel>
                                     <StackPanel Grid.Column="2">
                                         <TextBlock Text="Tag Offset from MEP (paper mm)" Style="{StaticResource FieldLabel}"/>
                                         <TextBox x:Name="offset_tb" Text="5"
                                                  ToolTip="Increase this value to push both Left/Right tag columns farther away from the MEP elements."/>
                                     </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                         <TextBlock Text="Tag Gap (paper mm)" Style="{StaticResource FieldLabel}"/>
                                         <TextBox x:Name="row_spacing_tb" Text="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="View Margin (paper mm)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="top_margin_tb" Text="5"/>
                                    </StackPanel>
                                 </Grid>
                                 <TextBlock Text="Visible gap between adjacent Tag Family text bounds = Tag Gap. Tag Offset moves both column rails outward from the MEP group."
                                            TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                             </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="3  LEADER STRATEGY" FontWeight="Bold" FontSize="14"/>
                                <Border Background="#163B2B" BorderBrush="#218B56" BorderThickness="1"
                                        CornerRadius="5" Padding="10" Margin="0,9,0,6">
                                    <StackPanel>
                                        <TextBlock Text="AUTO ADAPTIVE" Foreground="#58D68D" FontWeight="Bold"/>
                                        <TextBlock Text="Clear route: exact single horizontal line" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="Arrange nearby hosts above/below locked rows" FontSize="11"/>
                                        <TextBlock Text="Local blocks: never pull a tag into a distant group" FontSize="11"/>
                                        <TextBlock Text="Fallback: host-edge Free End + one 90° elbow" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Clearance (paper mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="clearance_tb" Text="2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="4  COLLISION &amp; ORDERING" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <CheckBox x:Name="avoid_elements_cb" Content="Avoid MEP + Architecture/Linked model" IsChecked="True"
                                          ToolTip="Avoid tag text over MEP and visible architectural elements from the host project or Revit Links. Architectural leader crossings are treated as a soft constraint."/>
                                <CheckBox x:Name="avoid_leaders_cb" Content="Avoid other leaders" IsChecked="True"/>
                                <CheckBox x:Name="avoid_text_cb" Content="Avoid tag text" IsChecked="True"/>
                                <Separator Margin="0,7" Background="#45505B"/>
                                <TextBlock Text="Priority: Top to Bottom" FontWeight="SemiBold"/>
                                <CheckBox x:Name="lock_upper_cb" Content="Lock upper leaders first" IsChecked="True"/>
                                <CheckBox x:Name="move_lower_cb" Content="Move lower tag first" IsChecked="True"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="tag_count_text" Text="0" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="Selected" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="elbow_count_text" Text="0" FontSize="22" FontWeight="Bold" Foreground="#F2A11B"/>
                                    <TextBlock Text="One-elbow" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="clash_count_text" Text="0" FontSize="22" FontWeight="Bold" Foreground="#58D68D"/>
                                    <TextBlock Text="Clashes" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="analysis_summary_text" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1B2128" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,10">
                <TextBlock x:Name="status_text" Text="Ready." Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,710,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="reset_btn" Content="RESET" MinWidth="105" Margin="0,0,8,0"/>
                    <Button x:Name="cancel_btn" Content="CANCEL" MinWidth="105" Margin="0,0,8,0"/>
                    <Button x:Name="apply_btn" Content="APPLY SELECTION + ANALYZE" MinWidth="220" Margin="0,0,8,0"/>
                    <Button x:Name="write_btn" Content="WRITE ANALYZED TAGS TO REVIT" Style="{StaticResource PrimaryButton}" MinWidth="225"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
