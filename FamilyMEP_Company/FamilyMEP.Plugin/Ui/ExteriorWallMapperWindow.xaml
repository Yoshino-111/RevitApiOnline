<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exterior Wall Mapper"
        Width="1540" Height="920" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F7F9FC" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172033"/>
        <SolidColorBrush x:Key="Muted" Color="#657187"/>
        <SolidColorBrush x:Key="Border" Color="#DDE3ED"/>
        <SolidColorBrush x:Key="Blue" Color="#1155CC"/>
        <SolidColorBrush x:Key="BlueHover" Color="#0D47B5"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="BlueLine" Color="#BFD3F5"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#F1F5FA"/>
        <SolidColorBrush x:Key="Green" Color="#14966A"/>
        <SolidColorBrush x:Key="Amber" Color="#F2A11B"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
        <DropShadowEffect x:Key="RaisedShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.11"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CAD4E2"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECF2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F6F8FB"/>
            <Setter Property="Foreground" Value="#25324A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F7FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDEBFF"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="IsExpanded" Value="False"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="MainTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="7" Padding="16,9" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#F7FAFE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="White"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Border}"/>
                                <Setter TargetName="TabSurface" Property="Effect" Value="{StaticResource RaisedShadow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="9" Padding="5" Margin="0,0,0,9">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="13,7" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#F7FAFE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource BlueSoft}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource BlueLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F7F9FC" BorderBrush="{StaticResource Border}"
                                    BorderThickness="0,0,0,1" Padding="8,7">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="5"
                                Padding="15,6" Margin="1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentTabControl" TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MaxWidth="570" HorizontalAlignment="Stretch" Margin="0,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="project_text" Text="Open a Revit project" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LINK HEALTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="link_health_text" Text="●  Not scanned" FontSize="13" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LINKS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="links_scanned_header_text" Text="0 / 0" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="scan_btn" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Content="◎  SCAN LINEAR COMPONENTS"/>
                    <Button x:Name="export_btn" Margin="0,3" Content="▣  EXPORT EXCEL"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="sidebar_scroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <Grid Margin="18,17,14,17">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,11">
                        <TextBlock Text="LEVEL" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Show all levels or filter one level" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TreeView x:Name="space_navigator" Grid.Row="1" MaxHeight="220" Margin="0,0,0,16"/>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Orientation" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox x:Name="orientation_filter_combo" Margin="0,6,0,12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox x:Name="status_filter_combo" Margin="0,6,0,14"/>
                    </StackPanel>
                    <Button x:Name="clear_filters_btn" Grid.Row="4" Content="↻  SHOW ALL LEVELS"/>
                    <Border Grid.Row="5" Background="#F3F7FC" BorderBrush="#D7E4F6" BorderThickness="1"
                            CornerRadius="7" Padding="11" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="ELEMENT ID(S)" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Paste the copy-only Excel column here" FontSize="10"
                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="element_id_textbox" Grid.Row="1" MinHeight="145" Padding="9,7"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     ToolTip="Paste one or many linked Revit/IFC Element IDs separated by semicolon, comma, space or a new line."/>
                            <Grid Grid.Row="2" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="focus_element_btn" Grid.Column="0" Margin="0,0,5,0"
                                        Content="⌖  FOCUS 3D" ToolTip="Highlight all pasted linked Element IDs in red in the 3D focus view."/>
                                <Button x:Name="focus_plan_btn" Grid.Column="1" Margin="5,0,0,0"
                                        Content="▣  PLAN" ToolTip="Highlight the pasted linked Element IDs in the matching Floor Plan."/>
                            </Grid>
                            <StackPanel Grid.Row="3" Margin="0,13,0,0">
                                <Grid Margin="1,0,1,4">
                                    <TextBlock Text="CONTEXT TRANSPARENCY" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="context_transparency_text" Text="0%" HorizontalAlignment="Right"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
                                </Grid>
                                <Slider x:Name="context_transparency_slider" Minimum="0" Maximum="90" Value="0"
                                        TickFrequency="10" IsSnapToTickEnabled="False"
                                        ToolTip="Fade the model context in the current Focus view. The transient red highlight stays opaque."/>
                                <TextBlock Text="0% = normal · 90% = maximum fade" FontSize="9"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,12,0,0">
                        <TextBlock Text="Excel → Element IDs Only (Copy/Paste) → FOCUS 3D. Use Level, Orientation and Status only to filter the result tables."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}"/>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="16,15,17,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,12">
                        <Grid>
                            <StackPanel><TextBlock Text="TOTAL EXTERIOR AREA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="total_area_text" Text="0.00 m²" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="44" Height="34" CornerRadius="17" Background="#E6F8F6"><TextBlock Text="m²" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#159A95"/></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,12">
                        <Grid>
                            <StackPanel><TextBlock Text="UNIQUE ASSEMBLIES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="unique_assemblies_text" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="48" Height="34" CornerRadius="17" Background="{StaticResource BlueSoft}"><TextBlock Text="ASM" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Blue}"/></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,12">
                        <Grid>
                            <StackPanel><TextBlock Text="NEEDS REVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="needs_review_text" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" Foreground="{StaticResource Amber}"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="44" Height="34" CornerRadius="17" Background="#FFF4DF"><TextBlock Text="QA" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#CF7E00"/></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,12">
                        <Grid>
                            <StackPanel><TextBlock Text="LINKS SCANNED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="links_scanned_text" Text="0 / 0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="48" Height="34" CornerRadius="17" Background="#E8F7F1"><TextBlock Text="RVT" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Green}"/></Border>
                        </Grid>
                    </Border>
                </Grid>

                <TabControl x:Name="results_tabs" Grid.Row="1"
                            Style="{StaticResource MainTabControl}"
                            ItemContainerStyle="{StaticResource MainTabItem}">
                    <TabItem Header="ROOM / ORIENTATION">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F3F7FC" BorderBrush="#D7E4F6" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                                <TextBlock Text="Space summary for LINEAR components. EWA/EWI use the largest sun-exposed facade; IWA includes boundaries adjoining another Space. Technical layer checks are under DETAIL."
                                           TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <DataGrid x:Name="room_summary_grid" Grid.Row="1" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="90"/>
                                    <DataGridTextColumn Header="SPACE NUMBER / NAME" Binding="{Binding SpaceGroupLabel}" Width="*" MinWidth="330"/>
                                    <DataGridTextColumn Header="LINEAR TYPE" Binding="{Binding LinearCategories}" Width="105"/>
                                    <DataGridTextColumn Header="ORIENTATION" Binding="{Binding Orientation}" Width="140"/>
                                    <DataGridTextColumn Header="WALL GROUPS" Binding="{Binding WallGroupCount}" Width="140"/>
                                    <DataGridTextColumn Header="WALL TYPES" Binding="{Binding ArchitecturalWallTypeCount}" Width="120"/>
                                    <DataGridTextColumn Header="LAYER COUNT (MIN - MAX)" Binding="{Binding LayerCountDisplay}" Width="190"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="DETAIL">
                        <TabControl x:Name="detail_tabs"
                                    Style="{StaticResource DetailTabControl}"
                                    ItemContainerStyle="{StaticResource DetailTabItem}">
                    <TabItem Header="STRUCTURES">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="245"/>
                            </Grid.RowDefinitions>

                <DataGrid x:Name="walls_grid" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True"
                          ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="65"/>
                        <DataGridTextColumn Header="SPACE NUMBER / NAME" Binding="{Binding SpaceGroupLabel}" Width="215"/>
                        <DataGridTextColumn Header="LINEAR" Binding="{Binding LinearCategory}" Width="62"/>
                        <DataGridTextColumn Header="ORIENT." Binding="{Binding Orientation}" Width="78"/>
