                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MATCHING WALL MATERIAL + THICKNESS" FontWeight="Bold" Foreground="#17233A"/>
                                        <TextBlock Text="Groups EWA/IWA walls by identical layer material sequence and measured thickness. Openings are associated by Space, orientation and overlapping linked geometry."
                                                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="wall_type_group_count_text" Text="0 wall groups"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource Blue}" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="wall_type_groups_grid" Grid.Row="1" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GROUP" Binding="{Binding GroupId}" Width="75"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding LinearCategory}" Width="58"/>
                                    <DataGridTextColumn Header="THICKNESS" Binding="{Binding Thickness}" Width="95"/>
                                    <DataGridTextColumn Header="LAYERS" Binding="{Binding LayerCount}" Width="58"/>
                                    <DataGridTextColumn Header="COMPONENT / MATERIAL" Binding="{Binding Materials}" Width="*" MinWidth="270"/>
                                    <DataGridTextColumn Header="MATERIAL CLASS" Binding="{Binding MaterialClasses}" Width="130"/>
                                    <DataGridTextColumn Header="ROOMS" Binding="{Binding RoomCount}" Width="65"/>
                                    <DataGridTextColumn Header="OCCURRENCES" Binding="{Binding WallOccurrenceCount}" Width="90"/>
                                    <DataGridTextColumn Header="WALL ELEMENTS" Binding="{Binding WallElementCount}" Width="95"/>
                                    <DataGridTextColumn Header="AREA m2" Binding="{Binding Area}" Width="75"/>
                                    <DataGridTextColumn Header="OPENINGS" Binding="{Binding OpeningCount}" Width="72"/>
                                    <DataGridTextColumn Header="OPENING TYPES" Binding="{Binding OpeningTypes}" Width="115"/>
                                    <DataGridTextColumn Header="LINEAR MATERIAL PROPOSAL" Binding="{Binding LinearMaterialProposal}" Width="300"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#F6F8FB" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1,1,1,0" Padding="12,0">
                                <Grid>
                                    <TextBlock Text="SPACES AND ASSOCIATED OPENINGS" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="wall_type_occurrence_count_text" Text="Select a wall group above"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource Blue}" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="wall_type_occurrences_grid" Grid.Row="3" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="80"/>
                                    <DataGridTextColumn Header="SPACE NUMBER" Binding="{Binding SpaceNumber}" Width="125"/>
                                    <DataGridTextColumn Header="ROOM NAME" Binding="{Binding RoomName}" Width="*" MinWidth="220"/>
                                    <DataGridTextColumn Header="ORIENTATION" Binding="{Binding Orientation}" Width="105"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding WallType}" Width="58"/>
                                    <DataGridTextColumn Header="THICKNESS" Binding="{Binding Thickness}" Width="95"/>
                                    <DataGridTextColumn Header="AREA m2" Binding="{Binding Area}" Width="75"/>
                                    <DataGridTextColumn Header="WALL ELEMENTS" Binding="{Binding WallElements}" Width="95"/>
                                    <DataGridTextColumn Header="OPENING COUNT" Binding="{Binding OpeningCount}" Width="95"/>
                                    <DataGridTextColumn Header="OPENING TYPES" Binding="{Binding OpeningTypes}" Width="105"/>
                                    <DataGridTextColumn Header="OPENINGS IN SAME SPACE + ORIENTATION" Binding="{Binding OpeningsInSameSpaceAndOrientation}" Width="420"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0"><TextBlock x:Name="status_text" Text="Ready. Scan exterior walls to begin." VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock x:Name="row_count_text" Text="0 rows" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
        </Border>
    </Grid>
</Window>
