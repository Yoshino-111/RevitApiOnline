                            <Border Style="{StaticResource PanelStyle}"><StackPanel><TextBlock Text="Warnings" FontWeight="SemiBold"/><TextBlock x:Name="report_warnings_tb" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="Current scan status" Foreground="{StaticResource MutedInkBrush}"/></StackPanel></Border>
