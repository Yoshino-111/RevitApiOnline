                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"><TextBlock Text="General&#x0a;Application behavior" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
