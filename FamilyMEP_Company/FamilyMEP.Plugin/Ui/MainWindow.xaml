                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="145"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="batch_progress_label_tb" Text="Ready" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="batch_progress_bar" Grid.Column="1" Height="8" Minimum="0" Maximum="1" Value="0" Margin="10,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"/>
                                <TextBlock x:Name="batch_elapsed_tb" Grid.Column="2" Text="Elapsed 00:00" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedInkBrush}"/>
                                <TextBlock x:Name="batch_remaining_tb" Grid.Column="3" Text="Remaining --" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedInkBrush}"/>
                                <Button x:Name="batch_pause_btn" Grid.Column="4" Content="Pause" Height="32" IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="legacy_batch_workspace" Visibility="Collapsed" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="batch_select_all_btn" Content="Select / Clear All" Width="150" Margin="0,0,10,0"/>
                        <Button x:Name="batch_validate_btn" Content="Read Parameters" Width="140" Margin="0,0,10,0"/>
                        <Button x:Name="run_batch_btn" Content="Rename Parameters" Width="170" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="batch_export_log_btn" Content="Export Log" Width="120" Margin="0,0,10,0"/>
                        <Button x:Name="batch_undo_preview_btn" Content="Restore Latest Backup" Width="180"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="410"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. Operation" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <TextBlock Text="Rename Parameter" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="Renames matching family parameters in the selected RFA files. Enable backup before running so the whole session can be restored." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="4,6,4,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="2. Safe Workflow" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="1  Select family rows" Margin="0,0,0,10"/>
                                    <TextBlock Text="2  Read parameters and verify matches" Margin="0,0,0,10"/>
                                    <TextBlock Text="3  Keep Create Backup enabled" Margin="0,0,0,10"/>
                                    <TextBlock Text="4  Run rename and review the log" Margin="0,0,0,16"/>
                                    <Separator Margin="0,0,0,14"/>
                                    <TextBlock Text="Only files on drive F: can be edited. A backup manifest is created for every batch session." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="250"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="batch_selection_title_tb" Text="3. Select Families and Parameters" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.05*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="A. Families" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                            <DataGrid x:Name="batch_family_grid" Grid.Row="1" SelectionMode="Extended" SelectionUnit="FullRow">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="" Binding="{Binding Selected}" Width="34"/>
                                                    <DataGridTextColumn Header="Family Name" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="B. Parameters in Selected Families" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                            <DataGrid x:Name="batch_parameter_grid" Grid.Row="1" SelectionMode="Extended" SelectionUnit="FullRow">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Rename To" Binding="{Binding NewName}" Width="*"/>
                                                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120"/>
                                                    <DataGridTextColumn Header="In Families" Binding="{Binding FoundIn}" Width="82"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="56"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="5. Batch Edit Status" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                        <TextBlock x:Name="batch_queued_tb" Text="0 Queued" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,28,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="batch_success_tb" Text="0 Success" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,28,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="batch_warning_tb" Text="0 Warnings" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="0,0,28,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="batch_error_tb" Text="0 Errors" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataGrid x:Name="batch_log_grid" Grid.Row="1">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                                            <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName}" Width="170"/>
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="4. Rename Parameter Workflow" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,18"/>
                                    <TextBlock Text="Parameter Name Contains" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="batch_old_parameter_tb" Text="Width" Margin="0,0,0,12"/>
                                    <TextBlock Text="Replace With" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="batch_new_parameter_tb" Text="Duct_Width" Margin="0,0,0,16"/>
                                    <CheckBox x:Name="batch_create_backup_cb" Content="Create Backup (.bak) before editing" IsChecked="True"/>
                                    <CheckBox x:Name="batch_save_after_edit_cb" Content="Save Families After Edit" IsChecked="True"/>
                                    <CheckBox x:Name="batch_reload_project_cb" Content="Open Load to Project after editing" IsChecked="False"/>
                                    <Separator Margin="0,8,0,16"/>
                                    <TextBlock Text="Preview of Changes" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                    <DataGrid Height="180" ItemsSource="{Binding ElementName=batch_parameter_grid, Path=ItemsSource}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="*"/>
                                            <DataGridTextColumn Header="In" Binding="{Binding FoundIn}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,16" Background="#FAFBFE">
                                        <StackPanel>
                                            <TextBlock Text="Workflow Summary" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBlock Text="Action: Rename Parameter" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="batch_summary_old_tb" Text="Find Text: Width" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="batch_summary_new_tb" Text="Replace With: Duct_Width" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="batch_summary_scope_tb" Text="Scope: 0 families" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="batch_summary_backup_tb" Text="Backup: Enabled" Margin="0,0,0,6"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="batch_run_side_btn" Content="Rename Parameters" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Parameters"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="parameter_read_btn" Content="Read Selected Families" Width="190" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="parameter_export_btn" Content="Export CSV" Width="120" Margin="0,0,16,0"/>
                        <TextBlock Text="Select families in Browser or Batch Edit first. Reading RFA data uses the Revit API." Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Filters" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                                <TextBlock Text="Search name, group or data type" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,6"/>
                                <TextBox x:Name="parameter_search_tb" Margin="0,0,0,16"/>
                                <CheckBox x:Name="parameter_shared_only_cb" Content="Shared parameters only" Margin="0,0,0,16"/>
                                <Separator Margin="0,0,0,16"/>
                                <TextBlock Text="Scope" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="parameter_scope_tb" Text="No families read" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <TextBlock Text="Tip" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Use this page to compare parameter names, groups, data types and instance/type bindings before a batch edit." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="parameter_count_tb" Text="Parameters (0)" Style="{StaticResource SectionTitleStyle}"/>
                                <DataGrid x:Name="parameter_grid" Grid.Row="1" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter Name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="170"/>
                                        <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="130"/>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding InstanceType}" Width="90"/>
                                        <DataGridCheckBoxColumn Header="Shared" Binding="{Binding Shared}" Width="70"/>
                                        <DataGridTextColumn Header="Families" Binding="{Binding FoundIn}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Parameter Details" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                                <TextBlock Text="Name" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_name_tb" Text="Select a parameter" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <TextBlock Text="Group" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_group_tb" Text="-" Margin="0,0,0,14"/>
                                <TextBlock Text="Data Type" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_type_tb" Text="-" Margin="0,0,0,14"/>
                                <TextBlock Text="Binding" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_binding_tb" Text="-" Margin="0,0,0,14"/>
                                <TextBlock Text="Shared" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_shared_tb" Text="-" Margin="0,0,0,14"/>
                                <TextBlock Text="Found In" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_found_tb" Text="-" Margin="0,0,0,14"/>
                                <TextBlock Text="Formula" Style="{StaticResource SmallLabelStyle}" Margin="0,0,0,5"/>
                                <TextBlock x:Name="parameter_detail_formula_tb" Text="-" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="standards_tab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Standards"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="10" BorderBrush="#D9D2FF" BorderThickness="1" Margin="0,0,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F4F0FF" Offset="0"/>
                                <GradientStop Color="#FBFCFF" Offset="0.55"/>
                                <GradientStop Color="#EEF5FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Project Standards Library" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="Capture and reuse native Revit view templates, parameter filters and graphic overrides." Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="standards_refresh_btn" Grid.Column="2" Content="&#xE72C;  Refresh" FontFamily="Segoe UI, Segoe MDL2 Assets" Width="108" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button x:Name="standards_remove_btn" Grid.Column="3" Content="&#xE74D;  Remove" FontFamily="Segoe UI, Segoe MDL2 Assets" Width="112" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button x:Name="standards_save_tool_btn" Grid.Column="4" Content="&#xE74E;  Save to Tool Library"
                                    FontFamily="Segoe UI, Segoe MDL2 Assets" Width="170" Margin="0,0,8,0"
                                    VerticalAlignment="Center" ToolTip="Save families and annotations from the selected RVT source into the managed Tool Library"/>
                            <Button x:Name="standards_add_rvt_btn" Grid.Column="5" Content="&#xE8E5;  Add RVT Source" FontFamily="Segoe UI, Segoe MDL2 Assets" Width="158" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="270"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F7F5FF" CornerRadius="7" Padding="12,8" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="standards_sources_count_tb" Text="0" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="RVT Sources" Foreground="{StaticResource MutedInkBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#EEF7FF" CornerRadius="7" Padding="12,8" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2878D0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="standards_templates_count_tb" Text="0" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="Templates" Foreground="{StaticResource MutedInkBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="#EEFAF3" CornerRadius="7" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="standards_filters_count_tb" Text="0" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="View Filters" Foreground="{StaticResource MutedInkBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="4">
                                <TextBox x:Name="standards_search_tb" Padding="36,7,10,7" ToolTip="Search filters and view templates"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedInkBrush}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <ComboBox x:Name="standards_kind_combo" Grid.Column="5" SelectedIndex="0" Margin="8,0,0,0">
                                <ComboBoxItem Content="All Standards" Tag="All"/>
                                <ComboBoxItem Content="View Templates" Tag="ViewTemplate"/>
                                <ComboBoxItem Content="View Filters" Tag="ViewFilter"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,12,0" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid MinHeight="34">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Saved Sources" Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <Button x:Name="standards_add_source_side_btn" Grid.Column="1" Content="+  Add Source"
                                            Width="120" Height="32" Padding="10,4" FontSize="12"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Saved RVT snapshots on drive F:" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                <ListBox x:Name="standards_project_list" Grid.Row="2" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Background="Transparent" MinHeight="142">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="42" CornerRadius="7" Background="#215FC1" VerticalAlignment="Top">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="R" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="RVT" Foreground="White" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding OriginalPath}" Foreground="{StaticResource MutedInkBrush}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" Margin="0,5,0,0"/>
                                                        <Grid Margin="0,11,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#2878D0" Margin="0,0,6,0"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding TemplateCount}" FontWeight="SemiBold" FontSize="11"/>
                                                                    <TextBlock Text="Templates" Foreground="{StaticResource MutedInkBrush}" FontSize="9"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding FilterCount}" FontWeight="SemiBold" FontSize="11"/>
                                                                    <TextBlock Text="View Filters" Foreground="{StaticResource MutedInkBrush}" FontSize="9"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding ImportedLabel, StringFormat=Last scanned: {0}}"
                                                                   Foreground="{StaticResource MutedInkBrush}" FontSize="9" Margin="0,11,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Border Background="#E7F0FF" CornerRadius="8" Padding="7,2">
                                                            <TextBlock Text="{Binding VersionLabel}" Foreground="#215FC1" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedInkBrush}"
