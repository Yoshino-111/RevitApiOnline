                                            <TextBlock Grid.Row="3" Text="Warnings" Foreground="{StaticResource WarningBrush}"/><TextBlock x:Name="batch_summary_warnings2_tb" Grid.Row="3" Grid.Column="1" Text="0" Foreground="{StaticResource WarningBrush}"/>
