                                                    <DataGridTextColumn Header="Families" Binding="{Binding FoundIn}" Width="75"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Style="{StaticResource BatchInnerTabItemStyle}"><TabItem.Header><TextBlock x:Name="batch_changes_tab_tb" Text="Changes (0)"/></TabItem.Header>
