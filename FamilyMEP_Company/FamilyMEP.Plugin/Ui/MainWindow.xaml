<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FamilyMEP"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#F6F8FC">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#F1F4FA"/>
        <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FBFCFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E1ED"/>
        <SolidColorBrush x:Key="StrongBorderBrush" Color="#C8D3E2"/>
        <SolidColorBrush x:Key="FamilyBorderBrush" Color="#7186A3"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1F2A44"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="#64708A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6637F5"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFE9FF"/>
        <SolidColorBrush x:Key="AccentPaleBrush" Color="#F6F1FF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#19A85A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F2A100"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E23A4F"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#FAFBFE"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TabGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>

        <Style x:Key="IconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TabIconPathStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
            <Setter Property="Stroke" Value="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="WhiteIconPathStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
            <Setter Property="Stroke" Value="White"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="button_border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="button_border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="button_border" Property="Background" Value="#FBFAFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="button_border" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="BatchOperationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="BatchOperationActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource BatchOperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BatchInnerTabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="inner_tab_border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="inner_tab_border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BatchValidationPillTemplate">
            <Border x:Name="validation_pill" Background="#EEF1F5" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left">
                <TextBlock x:Name="validation_text" Text="{Binding Validation}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Validation}" Value="Ready"><Setter TargetName="validation_pill" Property="Background" Value="#E7F7EC"/><Setter TargetName="validation_text" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Validation}" Value="Warning"><Setter TargetName="validation_pill" Property="Background" Value="#FFF3D6"/><Setter TargetName="validation_text" Property="Foreground" Value="#C77B00"/></DataTrigger>
                <DataTrigger Binding="{Binding Validation}" Value="Error"><Setter TargetName="validation_pill" Property="Background" Value="#FDE8EC"/><Setter TargetName="validation_text" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Validation}" Value="Skip"><Setter TargetName="validation_pill" Property="Background" Value="#ECEFF3"/><Setter TargetName="validation_text" Property="Foreground" Value="#5F6878"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BatchFamilyStatusPillTemplate">
            <Border x:Name="family_status_pill" Background="#EEF1F5" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left">
                <TextBlock x:Name="family_status_text" Text="{Binding Status}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter TargetName="family_status_pill" Property="Background" Value="#E7F7EC"/><Setter TargetName="family_status_text" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OK"><Setter TargetName="family_status_pill" Property="Background" Value="#E7F7EC"/><Setter TargetName="family_status_text" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter TargetName="family_status_pill" Property="Background" Value="#FFF3D6"/><Setter TargetName="family_status_text" Property="Foreground" Value="#C77B00"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error"><Setter TargetName="family_status_pill" Property="Background" Value="#FDE8EC"/><Setter TargetName="family_status_text" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skip"><Setter TargetName="family_status_pill" Property="Background" Value="#ECEFF3"/><Setter TargetName="family_status_text" Property="Foreground" Value="#5F6878"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource AltRowBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F5FA"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#F8FAFD"
                                    BorderBrush="{StaticResource StrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,0">
                                <UniformGrid IsItemsHost="True" Columns="1" Rows="4" Margin="7,10,7,10"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="SelectedContent"
                                              Margin="14,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab_border"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid ClipToBounds="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="112"
                                  Height="28"
                                  TextElement.FontSize="12"
                                  TextElement.FontWeight="Bold"
                                  TextElement.FontStyle="Normal">
                                <Grid.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </Grid.LayoutTransform>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tab_border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="tab_border" Property="Background" Value="{StaticResource AccentPaleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="item_border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="item_border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="item_border" Property="BorderThickness" Value="2.5"/>
                                <Setter TargetName="item_border" Property="Background" Value="#FBFAFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="item_border" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CategoryItemTemplate">
            <Border x:Name="category_row" CornerRadius="6" Padding="10,8" Margin="{Binding IndentMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="category_toggle_tb"
                               Text="{Binding ExpandGlyph}"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Path Grid.Column="1" Data="{Binding CategoryIconData}" Style="{StaticResource IconPathStyle}" Width="15" Height="15" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2"
                               x:Name="category_name_tb"
                               Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3"
                               x:Name="category_count_tb"
                               Text="{Binding Count}"
                               FontSize="12"
                               Foreground="{StaticResource MutedInkBrush}"
                               Margin="10,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="category_name_tb" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="category_count_tb" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="category_count_tb" Property="Foreground" Value="{StaticResource InkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="False">
                    <Setter TargetName="category_name_tb" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="category_toggle_tb" Property="Text" Value=""/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="FamilyCardItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FamilyCardTemplate">
            <Border x:Name="family_card_border" Background="White" Width="174" Height="218" Padding="10" Margin="0,0,10,10" BorderThickness="1" BorderBrush="#D6DFEB" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="8" Background="#F5F7FB" BorderBrush="#E0E6EF" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Viewbox Margin="22,22,22,18" Opacity="0.7">
                                <Canvas Width="180" Height="86">
                                    <Path Data="M54,24 L136,24 L160,10 L78,10 Z" Fill="#E4E8EF" Stroke="#5D6878" StrokeThickness="1.6"/>
                                    <Rectangle Canvas.Left="54" Canvas.Top="24" Width="82" Height="34" Fill="#B8C0CC" Stroke="#5D6878" StrokeThickness="1.6"/>
                                    <Rectangle Canvas.Left="28" Canvas.Top="37" Width="45" Height="36" Fill="#7B8491" Stroke="#434C59" StrokeThickness="1.6"/>
                                    <Rectangle Canvas.Left="130" Canvas.Top="32" Width="38" Height="42" Fill="#C9CFD9" Stroke="#5D6878" StrokeThickness="1.6"/>
                                    <Line X1="73" Y1="37" X2="136" Y2="24" Stroke="#5D6878" StrokeThickness="1.2"/>
                                    <Line X1="136" Y1="58" X2="168" Y2="74" Stroke="#87909D" StrokeThickness="1"/>
                                </Canvas>
                            </Viewbox>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="5" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border x:Name="favorite_star_border" Tag="favorite-toggle" ToolTip="Add or remove from Favorites" HorizontalAlignment="Right" VerticalAlignment="Top" Width="25" Height="25" CornerRadius="13" Background="#F2FFFFFF" BorderBrush="#E2E7EF" BorderThickness="1" Margin="0,7,7,0" Panel.ZIndex="3" Cursor="Hand">
                                <TextBlock x:Name="favorite_star_tb" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#77839A" IsHitTestVisible="False"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.7" Foreground="{StaticResource InkBrush}" Margin="1,8,1,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15"/>
                    <TextBlock Grid.Row="2" Text="{Binding Types}" FontSize="10.8" Foreground="{StaticResource MutedInkBrush}" Margin="1,2,1,0" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="3" Margin="1,7,1,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FileSize}" FontSize="10.8" Foreground="#48546A" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" CornerRadius="9" Padding="7,3" Background="#E9F8F0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding StatusGlyph}" FontSize="10.2" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="family_card_border" Property="BorderBrush" Value="#9EAEC4"/>
                    <Setter TargetName="family_card_border" Property="Background" Value="#FCFDFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="family_card_border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="family_card_border" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="family_card_border" Property="Background" Value="{StaticResource AccentPaleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter TargetName="favorite_star_tb" Property="Text" Value="&#xE735;"/>
                    <Setter TargetName="favorite_star_tb" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="favorite_star_border" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter TargetName="favorite_star_border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FamilyCompactCardTemplate">
            <Border Style="{StaticResource CardStyle}" Width="126" Height="160" Padding="8" Margin="0,0,8,8" BorderThickness="2.6" BorderBrush="{StaticResource FamilyBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="5" Background="White" BorderBrush="#8FA2BC" BorderThickness="1.8" ClipToBounds="True">
                        <Grid>
                            <Viewbox Margin="14,14,14,12">
                                <Canvas Width="160" Height="76">
                                    <Path Data="M48,21 L120,21 L142,9 L70,9 Z" Fill="#E4E8EF" Stroke="#5D6878" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="48" Canvas.Top="21" Width="72" Height="30" Fill="#B8C0CC" Stroke="#5D6878" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="24" Canvas.Top="33" Width="40" Height="32" Fill="#7B8491" Stroke="#434C59" StrokeThickness="1.5"/>
