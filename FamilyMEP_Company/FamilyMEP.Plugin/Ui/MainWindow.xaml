                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                        <TextBlock Text="Run Summary" Style="{StaticResource SectionTitleStyle}"/>
