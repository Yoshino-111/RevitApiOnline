<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FamilyMEP - Spinkler"
        Height="900"
        Width="1500"
        MinHeight="780"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F5F7F8" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#172536" />
        <SolidColorBrush x:Key="SoftBrush" Color="#647383" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0E6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0AA6A6" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F8F7" />
        <SolidColorBrush x:Key="CoralBrush" Color="#EF6A5B" />
        <SolidColorBrush x:Key="VioletBrush" Color="#7657D5" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F5B83D" />
        <SolidColorBrush x:Key="GreenBrush" Color="#39A96B" />
        <SolidColorBrush x:Key="RedBrush" Color="#D94B4B" />

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.08" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#EEF2F4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E3EBEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#078C8C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,10" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF4F3" />
            <Setter Property="BorderBrush" Value="#F2C0BB" />
            <Setter Property="Foreground" Value="#B63A30" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E7ECEF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="RowHeight" Value="46" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="Padding" Value="18,10,18,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F4FBFB" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#078C8C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="CompactToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="InspectorToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="54" Height="54" VerticalAlignment="Center">
                    <Border Background="#E5F8F7" CornerRadius="14" />
                    <Canvas Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,11 L 22,11 L 22,29 L 35,29" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource CoralBrush}" Canvas.Left="1" Canvas.Top="7">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Left)" Duration="0:0:2.4">
                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="18" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="31" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)" Duration="0:0:2.4">
                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="7" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="7" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="25" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource VioletBrush}" Canvas.Left="31" Canvas.Top="25">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.7" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.75" To="1.15" Duration="0:0:0.7" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.75" To="1.15" Duration="0:0:0.7" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                            <Ellipse.RenderTransform>
                                <ScaleTransform CenterX="4" CenterY="4" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Spinkler" FontSize="24" FontWeight="Bold" />
                        <Border Margin="12,2,0,0" Padding="8,3" Background="#E9F6EC" BorderBrush="#BFE3C9" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="C# MODELESS" Foreground="#23834B" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="CAD Modeler  /  PDF &amp; DWG to native Revit systems"
                               Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource SoftBrush}" />
                </StackPanel>

                <Border Grid.Column="2" Background="#F5F7F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MODEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoftBrush}" />
                        <TextBlock x:Name="doc_name_text" Text="Active Model" Margin="0,2,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FBFCFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <TextBlock x:Name="step_text" Text="Step 1 of 5  /  Source" Foreground="{StaticResource SoftBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" />
                <TextBlock Text="Unified workflow: import, classify, connect, size, validate" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="main_tabs" Grid.Row="2" Margin="18,12,18,10">
            <TabItem Header="01   SOURCE">
                <Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.15*" />
                            <ColumnDefinition Width="1*" MinWidth="270" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#FBFCFD">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="v2_source_format_combo" Height="34" Margin="0,0,8,0" />
                                        <TextBox x:Name="v2_source_file_tb" Grid.Column="1" Height="34" IsReadOnly="True"
                                                 VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="v2_browse_source_btn" Content="Browse" Style="{StaticResource CompactToolButtonStyle}" />
                                            <Button x:Name="v2_replace_source_btn" Content="Replace" Margin="6,0,0,0"
                                                    Style="{StaticResource CompactToolButtonStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="12,0" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SoftBrush}" />
                                            <Border Width="42" Height="34" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White">
                                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="/ 1" VerticalAlignment="Center" Margin="7,0,12,0" />
                                            <Button x:Name="v2_source_zoom_out_btn" Content="−" Style="{StaticResource CompactToolButtonStyle}" ToolTip="Zoom out" />
                                            <Border Width="64" Height="34" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,1" Background="White">
                                                <TextBlock x:Name="v2_source_zoom_text" Text="100%" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Border>
                                            <Button x:Name="v2_source_zoom_in_btn" Content="+" Style="{StaticResource CompactToolButtonStyle}" ToolTip="Zoom in" />
                                            <Button x:Name="v2_source_fit_btn" Content="Fit" Margin="6,0,0,0" Style="{StaticResource CompactToolButtonStyle}" />
                                            <Button x:Name="v2_source_pan_btn" Content="✋" Margin="6,0,0,0" Style="{StaticResource CompactToolButtonStyle}" ToolTip="Pan with mouse" />
                                            <Button x:Name="v2_source_rotate_btn" Content="↻" Margin="6,0,0,0" Style="{StaticResource CompactToolButtonStyle}" ToolTip="Rotate page" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid x:Name="v2_source_pdf_host" Grid.Row="1" Background="#DCE1E4" ClipToBounds="True">
                                    <ScrollViewer x:Name="v2_source_pdf_scroll" Visibility="Collapsed"
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                  Padding="22" Background="#DCE1E4" Panel.ZIndex="2">
                                        <Image x:Name="v2_source_pdf_image" Stretch="Fill"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>
                                    <Border x:Name="v2_source_pdf_placeholder" Panel.ZIndex="1"
                                            Margin="36,24" Background="White" BorderBrush="#B9C4CB" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="v2_source_placeholder_title" Text="PDF" FontSize="24" FontWeight="Bold" Foreground="{StaticResource CoralBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="v2_source_placeholder_hint" Text="Select a real PDF to preview" Margin="0,8,0,0" Foreground="{StaticResource SoftBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="v2_scan_progress" Height="5" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Wheel zoom  •  Middle-drag pan" VerticalAlignment="Center"
                                               Foreground="{StaticResource SoftBrush}" FontSize="11" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" Padding="7,3" CornerRadius="4">
                                        <TextBlock x:Name="v2_source_quality_badge" Text="NATIVE PDF" FontSize="9" FontWeight="Bold" Foreground="#078C8C" />
                                    </Border>
                                    <TextBlock Text="IMPORT SETUP" FontSize="13" FontWeight="Bold" />
                                </DockPanel>
                                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                    <TextBlock Text="Target view" Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="v2_target_view_combo" />
                                    <Button x:Name="v2_place_pdf_in_revit_btn" Margin="0,8,0,0"
                                            Content="1  Place / select PDF in Revit" />
                                    <Button x:Name="v2_use_aligned_pdf_btn" Margin="0,5,0,0"
                                            Content="2  Use aligned PDF position" />
                                    <TextBlock x:Name="v2_placement_area_status_text" Margin="0,5,0,0"
                                               Text="PDF position not captured" TextWrapping="Wrap"
                                               Foreground="#C98200" FontSize="10.5" />
                                    <TextBlock Text="Target level" Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="v2_link_level_combo" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                    <TextBlock Text="Sprinkler family / type" Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="v2_sprinkler_family_combo" />
                                    <TextBlock Text="Elevation reference" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                                    <ComboBox x:Name="v2_sprinkler_reference_mode_combo" />
                                    <StackPanel x:Name="v2_sprinkler_reference_target_panel" Visibility="Collapsed">
                                        <TextBlock x:Name="v2_sprinkler_reference_target_label" Text="Reference target"
                                                   Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                                        <ComboBox x:Name="v2_sprinkler_reference_target_combo" />
                                    </StackPanel>
                                    <TextBlock x:Name="v2_sprinkler_elevation_label" Text="Offset above selected Level / floor"
                                               Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                                    <TextBox x:Name="v2_sprinkler_elevation_tb" Text="2700" />
                                    <TextBlock x:Name="v2_sprinkler_elevation_hint"
                                               Text="Final elevation = selected Level + offset"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource SoftBrush}" FontSize="10" />
                                </StackPanel>
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="System" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="v2_system_type_combo" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Units" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="v2_units_combo" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="v2_cad_units_panel" Grid.Row="3" Margin="0,66,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="DWG drawing units" Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="v2_cad_units_combo" />
                                    <TextBlock Text="Scale correction" Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                                    <TextBox x:Name="v2_cad_scale_factor_tb" Text="1.0" />
                                    <TextBlock Text="Controls CAD scale only; elevation still uses Input units above."
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource SoftBrush}" FontSize="10" />
                                    <TextBlock Text="Correction = required distance / measured distance. Example: 8 / 1.2 = 6.6667."
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="#C98200" FontSize="10" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Margin="0,28,0,0">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DOCUMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SoftBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <TextBlock Text="▧" FontSize="18" Foreground="{StaticResource CoralBrush}" Margin="0,0,9,0" />
                                                <TextBlock x:Name="v2_source_document_name" Text="Level_02_FP.pdf" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="v2_source_document_meta" Text="1 page" Margin="0,12,0,0" />
                                            <TextBlock Text="●  Vector content detected" Margin="0,14,0,0" Foreground="{StaticResource GreenBrush}" />
                                            <TextBlock Text="▲  Scale requires confirmation" Margin="0,12,0,0" Foreground="#C98200" />
                                            <TextBlock x:Name="v2_source_quality_text" Text="Ready to analyze"
                                                       Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource SoftBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Button x:Name="v2_scan_source_btn" Grid.Row="5" Content="Analyze Source"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                                <StackPanel Visibility="Collapsed">
                                    <TextBlock x:Name="v2_vector_count_text" Text="547" />
                                    <TextBlock x:Name="v2_symbol_count_text" Text="94" />
                                    <TextBlock x:Name="v2_unclassified_count_text" Text="21" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                <Grid Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.25*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource CardShadow}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

