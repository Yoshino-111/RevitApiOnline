                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" ClipToBounds="True">
