                            </Border>
                            <Border Grid.Row="2" Margin="14" Background="#F5F7F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Connected heads" Style="{StaticResource LabelStyle}" /><TextBlock Text="94" FontSize="20" FontWeight="Bold" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Remote candidates" Style="{StaticResource LabelStyle}" /><TextBlock Text="12" FontSize="20" FontWeight="Bold" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Blocked segments" Style="{StaticResource LabelStyle}" /><TextBlock Text="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource RedBrush}" /></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Proposed sizes" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Head connection" VerticalAlignment="Center" />
                                    <TextBlock x:Name="head_size_text" Grid.Column="1" Text="DN15" FontWeight="Bold" />
                                </Grid>
                                <Separator Margin="0,10" Background="#E1E7EB" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Branch pipe" VerticalAlignment="Center" /><TextBlock x:Name="branch_size_text" Grid.Column="1" Text="DN25 proposed" FontWeight="Bold" Foreground="{StaticResource CoralBrush}" /></Grid>
                                <Separator Margin="0,10" Background="#E1E7EB" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Main pipe" VerticalAlignment="Center" /><TextBlock x:Name="main_size_text" Grid.Column="1" Text="Pending" FontWeight="Bold" Foreground="#A46700" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="sizing_status_border" Margin="0,12,0,0" Background="#FFF2D6" BorderBrush="#F1D494" BorderThickness="1" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="Hydraulic verification" FontWeight="SemiBold" Foreground="#A46700" />
                                <TextBlock x:Name="sizing_status_text" Margin="0,4,0,0" Text="Preliminary only - add water supply data for hydraulic verification." TextWrapping="Wrap" FontSize="11" Foreground="#8D6B2C" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="05   REVIEW">
                <Grid Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#E9F7EF" BorderBrush="#BFE3C9" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Ready" FontWeight="SemiBold" Foreground="#23834B" /><TextBlock Text="372" FontSize="25" FontWeight="Bold" Foreground="#23834B" /></StackPanel></Border>
                        <Border Grid.Column="1" Background="#FFF7E7" BorderBrush="#F1D494" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Needs Review" FontWeight="SemiBold" Foreground="#A46700" /><TextBlock Text="18" FontSize="25" FontWeight="Bold" Foreground="#A46700" /></StackPanel></Border>
                        <Border Grid.Column="2" Background="#FFF1F0" BorderBrush="#F0C1BD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Blocked" FontWeight="SemiBold" Foreground="#B63A30" /><TextBlock Text="4" FontSize="25" FontWeight="Bold" Foreground="#B63A30" /></StackPanel></Border>
                        <Border Grid.Column="3" Background="#EEF5FF" BorderBrush="#C7D9F3" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="Proposed Elements" FontWeight="SemiBold" Foreground="#2D67A7" /><TextBlock Text="394" FontSize="25" FontWeight="Bold" Foreground="#2D67A7" /></StackPanel></Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <DockPanel Margin="16,14"><TextBlock Text="2D source / Revit connection review" Style="{StaticResource SectionTitleStyle}" /></DockPanel>
                                <Border Grid.Row="1" Background="#F8FAFB" BorderBrush="#E1E7EB" BorderThickness="0,1,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Canvas Grid.Column="0" Background="#FCFDFD">
                                            <Rectangle Canvas.Left="35" Canvas.Top="45" Width="330" Height="300" Stroke="#B8C1C8" StrokeThickness="2" />
                                            <Line X1="200" Y1="45" X2="200" Y2="345" Stroke="#CCD4DA" />
                                            <Line X1="35" Y1="190" X2="365" Y2="190" Stroke="#CCD4DA" />
                                            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="7" Data="M 70,250 L 330,250 M 200,250 L 200,100" />
                                            <Path Stroke="{StaticResource CoralBrush}" StrokeThickness="4" Data="M 200,100 L 100,100 M 200,100 L 310,100" />
                                            <Ellipse Canvas.Left="90" Canvas.Top="90" Width="20" Height="20" Stroke="{StaticResource VioletBrush}" StrokeThickness="3" />
                                            <Ellipse Canvas.Left="300" Canvas.Top="90" Width="20" Height="20" Stroke="{StaticResource VioletBrush}" StrokeThickness="3" />
                                            <TextBlock Canvas.Left="50" Canvas.Top="15" Text="INTERPRETED 2D" FontWeight="Bold" />
                                        </Canvas>
                                        <Canvas Grid.Column="1" Background="#F3F5F6">
                                            <Path Fill="#E1E5E8" Stroke="#BBC3C9" Data="M 50,315 L 200,180 L 390,250 L 230,385 Z" />
                                            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 95,280 L 270,205 L 355,235" />
                                            <Path Stroke="{StaticResource CoralBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 210,230 L 210,120 M 270,205 L 330,150" />
                                            <Line X1="210" Y1="120" X2="210" Y2="165" Stroke="{StaticResource AccentBrush}" StrokeThickness="5" />
                                            <Ellipse Canvas.Left="199" Canvas.Top="106" Width="22" Height="22" Stroke="{StaticResource VioletBrush}" StrokeThickness="3" Fill="White" />
                                            <Line X1="330" Y1="150" X2="330" Y2="110" Stroke="{StaticResource AccentBrush}" StrokeThickness="5" />
                                            <Ellipse Canvas.Left="319" Canvas.Top="92" Width="22" Height="22" Stroke="{StaticResource VioletBrush}" StrokeThickness="3" Fill="White" />
                                            <TextBlock Canvas.Left="30" Canvas.Top="15" Text="PROPOSED REVIT MODEL" FontWeight="Bold" />
                                        </Canvas>
                                        <Border HorizontalAlignment="Center" Width="38" Height="38" Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="19" VerticalAlignment="Center">
                                            <TextBlock Text="↔" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" Margin="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Verified elements can be created; blocked items remain untouched." Foreground="{StaticResource SoftBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Export report" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="Validation issues" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid x:Name="review_issue_grid" Grid.Row="1" Margin="0,12,0,0" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Severity}" Width="90" />
                                        <DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="2*" />
                                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.2*" />
                                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="65" />
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="status_text" Text="Ready" Foreground="{StaticResource SoftBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="close_btn" Content="Close" Margin="0,0,8,0" />
                    <Button x:Name="back_btn" Content="Back" Margin="0,0,8,0" />
                    <Button x:Name="next_btn" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="create_verified_btn" Content="Create Verified" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
