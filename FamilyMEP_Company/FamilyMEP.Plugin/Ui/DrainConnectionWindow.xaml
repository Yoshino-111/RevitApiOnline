<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drain Connection" Width="920" Height="700" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#F3F5F7"
        FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="Border" Color="#D8DEE5"/>
        <SolidColorBrush x:Key="Ink" Color="#20262D"/>
        <SolidColorBrush x:Key="Soft" Color="#68727D"/>
        <SolidColorBrush x:Key="Blue" Color="#1473E6"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="BorderBrush" Value="#0F62C4"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="31"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="31"/><Setter Property="Padding" Value="7,3"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style x:Key="CaseCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="Validation" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,8,4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DRAIN CONNECTION" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Choose a case, pick device and main, then create." FontSize="11" Foreground="{StaticResource Soft}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" CornerRadius="5" Background="#EEF5FD" BorderBrush="#C9DDF6" BorderThickness="1">
                    <TextBlock x:Name="runtime_badge_text" Text="Revit • Drain" Foreground="#245C93" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F8F9FB" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="CHOOSE CASE" FontSize="12" FontWeight="Bold" Margin="5,4,0,0"/>
                    <UniformGrid Grid.Row="1" Columns="2" Rows="3">
                        <Border x:Name="case01_card" Style="{StaticResource CaseCard}" BorderBrush="{StaticResource Blue}" BorderThickness="2">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions>
                                <Grid><Border Width="23" Height="23" CornerRadius="12" Background="#E8F2FF" HorizontalAlignment="Left"><TextBlock Text="01" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="AUTO Y" Margin="30,3,0,0" FontSize="11" FontWeight="Bold"/></Grid>
                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="White" Margin="0,3"><Image x:Name="case_thumb_image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <TextBlock Grid.Row="2" Text="Break main + Y" Foreground="{StaticResource Soft}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="case02_card" Style="{StaticResource CaseCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions>
                                <Grid><Border Width="23" Height="23" CornerRadius="12" Background="#EEF2F6" HorizontalAlignment="Left"><TextBlock Text="02" Foreground="#52606D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="45° TO Y" Margin="30,3,0,0" FontSize="11" FontWeight="Bold"/></Grid>
                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="White" Margin="0,3"><Image x:Name="case02_thumb_image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <TextBlock Grid.Row="2" Text="Elbow near main" Foreground="{StaticResource Soft}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="case03_card" Style="{StaticResource CaseCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions>
                                <Grid><Border Width="23" Height="23" CornerRadius="12" Background="#EEF2F6" HorizontalAlignment="Left"><TextBlock Text="03" Foreground="#52606D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ABOVE MAIN" Margin="30,3,0,0" FontSize="11" FontWeight="Bold"/></Grid>
                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="White" Margin="0,3"><Image x:Name="case03_thumb_image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <TextBlock Grid.Row="2" Text="Vertical plane" Foreground="{StaticResource Soft}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="case04_card" Style="{StaticResource CaseCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions>
                                <Grid><Border Width="23" Height="23" CornerRadius="12" Background="#EEF2F6" HorizontalAlignment="Left"><TextBlock Text="04" Foreground="#52606D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="OPEN END" Margin="30,3,0,0" FontSize="11" FontWeight="Bold"/></Grid>
                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="White" Margin="0,3"><Image x:Name="case04_thumb_image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <TextBlock Grid.Row="2" Text="Two 45° turns" Foreground="{StaticResource Soft}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="case05_card" Style="{StaticResource CaseCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions>
                                <Grid><Border Width="23" Height="23" CornerRadius="12" Background="#EEF2F6" HorizontalAlignment="Left"><TextBlock Text="05" Foreground="#52606D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="END ELBOW" Margin="30,3,0,0" FontSize="11" FontWeight="Bold"/></Grid>
                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="White" Margin="0,3"><Image x:Name="case05_thumb_image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <TextBlock Grid.Row="2" Text="No Y fitting" Foreground="{StaticResource Soft}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="case06_card" Style="{StaticResource CaseCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions>
                                <Grid><Border Width="23" Height="23" CornerRadius="12" Background="#EEF2F6" HorizontalAlignment="Left"><TextBlock Text="06" Foreground="#52606D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PARALLEL Y" Margin="30,3,0,0" FontSize="11" FontWeight="Bold"/></Grid>
                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="White" Margin="0,3"><Image x:Name="case06_thumb_image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <TextBlock Grid.Row="2" Text="Parallel + 45° + Y" Foreground="{StaticResource Soft}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="settings_title_text" Text="CASE 01" FontWeight="Bold" FontSize="15" Margin="0,0,0,9"/>
                        <Button x:Name="pick_route_btn" Content="PICK DEVICE + MAIN PIPE" Style="{StaticResource Primary}" Height="38" Margin="0,0,0,6"/>
                        <TextBlock x:Name="pick_help_text" Text="Pick device first, then main pipe." Foreground="#315C87" FontSize="11" Margin="2,0,0,9" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0"><TextBlock Text="DEVICE" Style="{StaticResource FieldLabel}"/><Border Background="#F7F8FA" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8,6" MinHeight="47"><TextBlock x:Name="source_text" Text="Not selected" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="11"/></Border></StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="MAIN PIPE" Style="{StaticResource FieldLabel}"/><Border Background="#F7F8FA" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8,6" MinHeight="47"><TextBlock x:Name="target_text" Text="Not selected" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="11"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock x:Name="slope_label" Text="Branch Slope (%)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="slope_tb" Text="2.0"/>
                                <TextBlock x:Name="y_roll_label" Text="Y Up-Roll (°)" Style="{StaticResource FieldLabel}" Margin="0,7,0,3" Visibility="Collapsed"/>
                                <TextBox x:Name="y_roll_tb" Text="0.0" IsEnabled="False" Visibility="Collapsed"/>
                                <TextBlock x:Name="y_roll_status_text" Text="Enter Y up-roll." FontSize="10" Foreground="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock x:Name="pipe_type_label" Text="Branch Pipe Type" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="pipe_type_combo"/>
                                <TextBlock x:Name="case04_middle_length_label" Text="Middle pipe between 45° elbows (mm)" Style="{StaticResource FieldLabel}" Margin="0,7,0,3" Visibility="Collapsed"/>
                                <TextBox x:Name="case04_middle_length_tb" Text="200" Visibility="Collapsed" IsEnabled="False"/>
                                <TextBlock x:Name="case04_middle_length_status_text" Text="Clear pipe length." FontSize="10" Foreground="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,5"><TextBlock x:Name="stage2_label_text" Text="Y FITTING" FontWeight="SemiBold"/><TextBlock x:Name="stage2_mode_text" Text="AUTO" HorizontalAlignment="Right" Foreground="{StaticResource Blue}" FontSize="11" FontWeight="SemiBold"/></Grid>
                                <ComboBox x:Name="junction_type_combo" Margin="0,0,0,3"/>
                                <TextBlock x:Name="junction_catalog_text" Text="Scanning Y types..." FontSize="10" Foreground="{StaticResource Soft}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,7"/>
                                <Grid><TextBlock x:Name="elbow_label_text" Text="45° Elbows" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="elbow_status_text" Text="Select a Pipe Type" HorizontalAlignment="Right" Foreground="{StaticResource Soft}" FontSize="11"/></Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="case_help_text" Text="" Visibility="Collapsed"/>
                        <Border Background="#F7F9FB" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,7,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="validation_source_text" Text="○ Source" Style="{StaticResource Validation}"/><TextBlock x:Name="validation_target_text" Text="○ Main" Style="{StaticResource Validation}"/><TextBlock x:Name="validation_elbow_text" Text="○ Elbows" Style="{StaticResource Validation}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="validation_junction_text" Text="○ Y fitting" Style="{StaticResource Validation}"/><TextBlock x:Name="validation_slope_text" Text="○ Slope" Style="{StaticResource Validation}"/><TextBlock x:Name="validation_flow_text" Text="○ Geometry" Style="{StaticResource Validation}"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#FFF8F3" BorderBrush="#E8D8CA" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,7,0,0"><TextBlock x:Name="status_text" Text="Ready." TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="11"/></Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,9"><Button x:Name="preview_btn" Content="VALIDATE" Width="120" HorizontalAlignment="Right" Margin="0,0,178,0"/><Button x:Name="create_btn" Content="CREATE CASE 01" Style="{StaticResource Primary}" Width="168" HorizontalAlignment="Right"/></Grid>
        </Border>

        <!-- Controller compatibility: visual previews now live in the six case cards. -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="preview_title_text"/><Image x:Name="plan_image"/><Image x:Name="detail_image"/><TextBlock x:Name="plan_summary_text"/>
            <Viewbox x:Name="case02_plan_view"/><Viewbox x:Name="case03_plan_view"/><Viewbox x:Name="case04_plan_view"/><Viewbox x:Name="case05_plan_view"/><Viewbox x:Name="case06_plan_view"/>
        </Grid>
    </Grid>
</Window>
